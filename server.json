{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.adrianov/rrubocop",
  "title": "rrubocop",
  "description": "Fast RuboCop-compatible Ruby linter with MCP inspect and autocorrect tools.",
  "websiteUrl": "https://github.com/adrianov/rrubocop",
  "repository": {
    "url": "https://github.com/adrianov/rrubocop",
    "source": "github"
  },
  "version": "0.8.3",
  "packages": [
    {
      "registryType": "cargo",
      "registryBaseUrl": "https://crates.io",
      "identifier": "rrubocop",
      "version": "0.8.3",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp"
        }
      ]
    }
  ]
}
